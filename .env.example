# .env.example — только шаблон, без реальных значений.
# Скопируйте в .env для локальной разработки; никогда не коммитьте .env.

# Будущее: путь к локальному зашифрованному хранилищу кейсов (необязательное переопределение)
# PGW_CASE_DIR=

# Будущее: уровень логирования (DEBUG | INFO | WARNING | ERROR)
# PGW_LOG_LEVEL=INFO
