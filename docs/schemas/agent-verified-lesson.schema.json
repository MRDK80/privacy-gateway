{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MRDK80/privacy-gateway/docs/schemas/agent-verified-lesson.schema.json",
  "title": "Private verified agent lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_id", "epic", "task", "task_class", "problem_class", "environment", "symptom_code", "diagnostic_steps", "minimal_fix", "applicability", "head_sha", "merge_sha", "pr", "iterations", "duration_seconds", "verification"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lesson_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "epic": {"type": "integer", "minimum": 1},
    "task": {"type": "integer", "minimum": 1},
    "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "problem_class": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "environment": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "symptom_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "diagnostic_steps": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
    "minimal_fix": {"type": "string"},
    "applicability": {"type": "string"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pr": {"type": "integer", "minimum": 1},
    "iterations": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "integer", "minimum": 0},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "controller", "pr_checks", "post_merge_checks"],
      "properties": {
        "gate": {"const": "PASS"},
        "controller": {"enum": ["PASS", "PASS_WITH_NOTES"]},
        "pr_checks": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"const": "SUCCESS"}},
        "post_merge_checks": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"const": "SUCCESS"}}
      }
    }
  }
}
